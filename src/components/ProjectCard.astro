---
import { base, statusLabel } from '../lib';
const { project } = Astro.props;
const d = project.data;
---
<a class="card" href={`${base}/projects/${project.id}/`}>
  <div class="card-meta">
    <span class={`status status-${d.status}`}>{statusLabel[d.status as keyof typeof statusLabel]}</span>
    {d.draft && <span class="draft">draft</span>}
  </div>
  <h3>{d.title}</h3>
  <p>{d.summary}</p>
  {d.stack.length > 0 && <div class="card-tags">{d.stack.map((t: string) => <span class="tag">{t}</span>)}</div>}
</a>
