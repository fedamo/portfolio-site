---
import { base, fmt, readingTime } from '../lib';
const { post } = Astro.props;
const d = post.data;
---
<a class="card" href={`${base}/blog/${post.id}/`}>
  <div class="card-meta">
    <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
    <span class="sep">·</span><span>{readingTime(post.body)} min read</span>
    {d.draft && <span class="draft">draft</span>}
  </div>
  <h3>{d.title}</h3>
  <p>{d.description}</p>
  {d.tags.length > 0 && <div class="card-tags">{d.tags.map((t: string) => <span class="tag">{t}</span>)}</div>}
</a>
