---
import Base from '../layouts/Base.astro';
import { getPosts, getDashboards, getProjects, base, fmt } from '../lib';
const posts = (await getPosts()).slice(0, 5);
const dashboards = (await getDashboards()).slice(0, 3);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---
<Base title="Defined Once · Waylon Sittampalam">
  <h1>Defined Once</h1>
  <p class="tagline">Governed, natural-language analytics on Snowflake. Fix the layer, not the prompt.</p>
  <p>
    I'm building in public: metrics defined once in a semantic layer, agents that answer from those
    definitions, and a trust layer that makes every answer checkable. This site holds the write-ups and
    sample dashboards.
  </p>
  <p class="muted">By Waylon Sittampalam, analytics engineer in Cary, NC.</p>

  <h2>Latest posts</h2>
  {posts.length === 0 ? <p class="muted">First post coming soon.</p> : (
    <ul class="cards">
      {posts.map((p) => (
        <li>
          <h3><a href={`${base}/blog/${p.id}/`}>{p.data.title}</a> {p.data.draft && <span class="draft">draft</span>}</h3>
          <div class="muted">{fmt(p.data.pubDate)}</div>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  )}

  {projects.length > 0 && (
    <>
      <h2>Projects</h2>
      <ul class="cards">
        {projects.map((p) => (
          <li>
            <h3><a href={`${base}/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Sample dashboards</h2>
  <ul class="cards">
    {dashboards.map((d) => (
      <li>
        <h3><a href={`${base}/${d.data.path}`}>{d.data.title}</a></h3>
        <p>{d.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
