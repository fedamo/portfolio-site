---
import Base from '../layouts/Base.astro';
import HeroSketch from '../components/HeroSketch.astro';
import EntryRow from '../components/EntryRow.astro';
import { getPosts, getDashboards, getProjects, base, fmt, readingTime, links, statusLabel } from '../lib';
const posts = (await getPosts()).slice(0, 4);
const projects = (await getProjects()).filter((p) => p.data.featured);
const dashboards = await getDashboards();
---
<Base title="Defined Once · Waylon Sittampalam">
  <section class="hero">
    <h1>Define it once.<br />Trust it everywhere.</h1>
    <p class="hero-sub">I can't multi-task, it's a good thing my agents can.</p>
    <p class="hero-lede">
      I'm Waylon Sittampalam, an analytics engineer in Cary, NC. I've spent 13 years in analytics, first in London
      and now in the US. At work I build BI models and the tools that check them. At home I build things for my
      family, like a homework tutor for my kids and a copilot for roasting coffee.
    </p>
    <p class="hero-links"><a href={`${base}/projects/`}>See the projects</a><a href={`${base}/about/`}>About me</a>{links.email && <a href={`mailto:${links.email}`}>Get in touch</a>}</p>
    <HeroSketch />
  </section>

  <section class="list-section">
    <h2 class="label">Writing</h2>
    {posts.length === 0 ? <p class="muted">First post coming soon.</p> : posts.map((p) => (
      <EntryRow href={`${base}/blog/${p.id}/`} title={p.data.title} summary={p.data.description}
        meta={`${fmt(p.data.pubDate)} · ${readingTime(p.body)} min read`} sketch={p.data.sketch} draft={p.data.draft} />
    ))}
    <p class="more"><a href={`${base}/blog/`}>All writing →</a></p>
  </section>

  <section class="list-section">
    <h2 class="label">Projects</h2>
    {projects.map((p) => (
      <EntryRow level="item" href={`${base}/projects/${p.id}/`} title={p.data.title} summary={p.data.summary}
        meta={statusLabel[p.data.status]} skills={p.data.skills} sketch={p.data.sketch} draft={p.data.draft} />
    ))}
    <p class="more"><a href={`${base}/projects/`}>All projects →</a></p>
  </section>

  {dashboards.length > 0 && (
  <section class="list-section">
    <h2 class="label">Dashboards</h2>
    {dashboards.map((d) => (
      <EntryRow level="item" href={`${base}/${d.data.path}`} title={d.data.title} summary={d.data.description}
        meta={d.data.syntheticData ? 'Interactive · placeholder data' : 'Interactive'} skills={d.data.skills} sketch={d.data.sketch} draft={d.data.draft} />
    ))}
    <p class="more"><a href={`${base}/dashboards/`}>All dashboards →</a></p>
  </section>
  )}
</Base>
