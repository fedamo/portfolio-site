---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DashboardCard from '../components/DashboardCard.astro';
import { getPosts, getDashboards, getProjects, base } from '../lib';
const posts = (await getPosts()).slice(0, 3);
const dashboards = (await getDashboards()).slice(0, 2);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 2);
---
<Base title="Defined Once · Waylon Sittampalam">
  <section class="hero">
    <p class="eyebrow">Governed analytics · Snowflake · AI</p>
    <h1>Define it once.<br />Trust it everywhere.</h1>
    <p class="hero-lede">
      I build governed, natural-language analytics: metrics defined once in a semantic layer, agents that
      answer from those definitions, and checks that make every answer verifiable.{' '}
      <strong>Fix the layer, not the prompt.</strong>
    </p>
    <p class="hero-by">
      Waylon Sittampalam · analytics engineer in Cary, NC ·{' '}
      <a href={`${base}/blog/`}>Read the blog</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Latest writing</h2>
      <a href={`${base}/blog/`}>All posts →</a>
    </div>
    {posts.length === 0 ? <p class="muted">First post coming soon.</p> : (
      <div class="card-list">{posts.map((p) => <PostCard post={p} />)}</div>
    )}
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Projects</h2>
        <a href={`${base}/projects/`}>All projects →</a>
      </div>
      <div class="card-list">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Sample dashboards</h2>
      <a href={`${base}/dashboards/`}>All dashboards →</a>
    </div>
    <div class="card-grid">{dashboards.map((d) => <DashboardCard item={d} />)}</div>
  </section>
</Base>
