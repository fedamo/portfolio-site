---
import Base from '../../layouts/Base.astro';
import DashboardCard from '../../components/DashboardCard.astro';
import { getDashboards } from '../../lib';
const items = await getDashboards();
---
<Base title="Dashboards · Defined Once" description="Sample dashboards built on made-up or public data.">
  <header class="page-head">
    <h1>Sample dashboards</h1>
    <p class="post-dek">Interactive examples built with D3 and plain HTML. All data is made up or public, and every number shows its definition.</p>
  </header>
  <div class="card-grid">{items.map((d) => <DashboardCard item={d} />)}</div>
</Base>
