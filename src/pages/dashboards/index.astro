---
import Base from '../../layouts/Base.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getDashboards, base } from '../../lib';
const items = await getDashboards();
---
<Base title="Dashboards · Defined Once" description="Interactive sample dashboards built on made-up or public data.">
  <header class="page-head">
    <h1>Dashboards</h1>
    <p class="page-dek">Interactive examples built with D3 and plain HTML. All data is made up or public, and every number shows its definition.</p>
  </header>
  <section class="list-section">
    {items.map((d) => (
      <EntryRow level="item" href={`${base}/${d.data.path}`} title={d.data.title} summary={d.data.description}
        meta={d.data.syntheticData ? 'Sample data' : undefined} skills={d.data.skills} sketch={d.data.sketch} draft={d.data.draft} />
    ))}
  </section>
</Base>
