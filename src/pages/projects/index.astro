---
import Base from '../../layouts/Base.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getProjects, base, statusLabel } from '../../lib';
const items = await getProjects();
---
<Base title="Projects · Defined Once" description="Things I've built, at work and at home.">
  <header class="page-head">
    <h1>Projects</h1>
    <p class="page-dek">Things I've built, at work and at home: the problem, how I solved it, and what I'd change.</p>
  </header>
  <section class="list-section">
    {items.length === 0 ? <p class="muted">Projects coming soon.</p> : items.map((p) => (
      <EntryRow level="item" href={`${base}/projects/${p.id}/`} title={p.data.title} summary={p.data.summary}
        meta={statusLabel[p.data.status]} skills={p.data.skills} sketch={p.data.sketch} draft={p.data.draft} />
    ))}
  </section>
</Base>
