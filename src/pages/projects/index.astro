---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib';
const items = await getProjects();
---
<Base title="Projects · Defined Once" description="Things I've built, at work and at home.">
  <header class="page-head">
    <h1>Projects</h1>
    <p class="post-dek">Things I've built, at work and at home: what the problem was, how I solved it, and what I'd change.</p>
  </header>
  {items.length === 0 ? <p class="muted">Projects coming soon.</p> : (
    <div class="card-list">{items.map((p) => <ProjectCard project={p} />)}</div>
  )}
</Base>
