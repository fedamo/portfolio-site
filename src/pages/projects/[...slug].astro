---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, base, statusLabel } from '../../lib';

export async function getStaticPaths() {
  const items = await getProjects();
  return items.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={`${d.title} · Defined Once`} description={d.summary}>
  <article>
    <p class="back"><a href={`${base}/projects/`}>← All projects</a></p>
    <header class="post-header">
      <h1>{d.title} {d.draft && <span class="draft">draft</span>}</h1>
      <p class="post-dek">{d.summary}</p>
      <div class="post-meta">
        <span class="status">{statusLabel[d.status]}</span>
        {d.demoUrl && <><span class="sep">·</span><a href={d.demoUrl}>Live demo</a></>}
        {d.repoUrl && <><span class="sep">·</span><a href={d.repoUrl}>Code</a></>}
        {d.stack.length > 0 && <span class="sep">·</span>}
        {d.stack.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
