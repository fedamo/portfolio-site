---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, base } from '../../lib';
const posts = await getPosts();
---
<Base title="Blog · Defined Once" description="Building governed analytics in public, one stage at a time.">
  <header class="page-head">
    <h1>Blog</h1>
    <p class="post-dek">Building governed analytics in public, and what I learn using AI to do it.</p>
    <p class="muted"><a href={`${base}/rss.xml`}>Subscribe via RSS</a></p>
  </header>
  <div class="card-list">{posts.map((p) => <PostCard post={p} />)}</div>
</Base>
