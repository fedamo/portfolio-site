---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Defined Once: governed, natural-language analytics on Snowflake, by Waylon Sittampalam.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Blog" href={`${base}/rss.xml`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href={`${base}/`}>Defined Once</a>
        <a href={`${base}/blog/`}>Blog</a>
        <a href={`${base}/projects/`}>Projects</a>
        <a href={`${base}/dashboards/`}>Dashboards</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="muted">Defined Once · by Waylon Sittampalam · built with Astro</footer>
  </body>
</html>
